<script>
  (function initTriageHUD() {
    // Dynamic Timestamp update
    const timeElem = document.getElementById('live-scan-time');
    if (timeElem) {
      const now = new Date();
      timeElem.textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }) + ' LOCAL';
    }

    const toast = document.getElementById('triage-toast');
    const toastMsg = document.getElementById('toast-msg');
    const toastIcon = document.getElementById('toast-icon');

    function triggerToast(message, iconName) {
      if (!toast) return;
      toastMsg.textContent = message;
      if (iconName && toastIcon) toastIcon.textContent = iconName;
      toast.classList.remove('translate-y-32');
      toast.classList.add('translate-y-0');
      setTimeout(() => {
        toast.classList.remove('translate-y-0');
        toast.classList.add('translate-y-32');
      }, 3500);
    }

    const gpsBtn = document.getElementById('btn-dispatch-gps');
    if (gpsBtn) {
      gpsBtn.addEventListener('click', () => {
        triggerToast('Current coordinates sent to Regional Dispatch (911).', 'share_location');
      });
    }

    const emtBtn = document.getElementById('btn-emt-code');
    if (emtBtn) {
      emtBtn.addEventListener('click', () => {
        triggerToast('EMT Code Red Triaged: Resuscitation channel opened.', 'crisis_alert');
      });
    }

    const exportBtn = document.getElementById('btn-export-pdf');
    if (exportBtn) {
      exportBtn.addEventListener('click', () => {
        triggerToast('Encrypted Clinical Summary generated.', 'description');
      });
    }

    const btHandoverBtn = document.getElementById('btn-bluetooth-handover');
    if (btHandoverBtn) {
      btHandoverBtn.addEventListener('click', () => {
        triggerToast('Broadcasting payload to local EMT Rig via BLE Mesh...', 'bluetooth');
      });
    }
  })();
</script></main>

