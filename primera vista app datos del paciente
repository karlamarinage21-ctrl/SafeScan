<script>
  // Elements
  const syncBtn = document.getElementById('nfc-sync-btn');
  const nfcModal = document.getElementById('nfc-modal');
  const nfcSheet = document.getElementById('nfc-sheet');
  const nfcCloseBtn = document.getElementById('nfc-close-btn');
  const nfcCancelBtn = document.getElementById('nfc-cancel-btn');
  const nfcDoneBtn = document.getElementById('nfc-done-btn');
  const nfcModalTitle = document.getElementById('nfc-modal-title');
  const nfcModalDesc = document.getElementById('nfc-modal-desc');
  const nfcProgressBar = document.getElementById('nfc-progress-bar');
  const nfcPercentText = document.getElementById('nfc-percent-text');
  const nfcBadgeText = document.getElementById('nfc-badge-text');
  const nfcBadgeDot = document.getElementById('nfc-badge-dot');
  const nfcCenterCircle = document.getElementById('nfc-center-circle');
  const nfcCenterIcon = document.getElementById('nfc-center-icon');
  const nfcCenterSub = document.getElementById('nfc-center-sub');
  const ripple1 = document.getElementById('ripple-1');
  const ripple2 = document.getElementById('ripple-2');
  const ripple3 = document.getElementById('ripple-3');
  const nfcPayloadStatus = document.getElementById('nfc-payload-status');

  let writeTimeout1 = null;
  let writeTimeout2 = null;
  let progressInterval = null;

  function openNfcModal() {
    // Reset state
    clearTimeout(writeTimeout1);
    clearTimeout(writeTimeout2);
    clearInterval(progressInterval);

    nfcModal.classList.remove('opacity-0', 'pointer-events-none');
    nfcModal.classList.add('opacity-100', 'pointer-events-auto');
    nfcSheet.classList.remove('translate-y-8', 'sm:translate-y-4');
    nfcSheet.classList.add('translate-y-0');

    // Initial Stage: Searching / Ready
    nfcBadgeText.textContent = 'READY TO WRITE • NTAG216 CHIP';
    nfcBadgeDot.className = 'w-1.5 h-1.5 rounded-full bg-secondary animate-pulse';
    nfcModalTitle.textContent = 'Hold Top of Phone Near Tag';
    nfcModalDesc.textContent = 'Scanning for SafeScan Tag #8821... Keep device steady near wristband crown.';
    nfcProgressBar.style.width = '0%';
    nfcProgressBar.className = 'h-full bg-gradient-to-r from-secondary to-tertiary rounded-full w-0 transition-all duration-300 ease-out';
    nfcPercentText.textContent = '0%';
    nfcCancelBtn.classList.remove('hidden');
    nfcDoneBtn.classList.add('hidden');
    nfcDoneBtn.classList.remove('flex');

    nfcCenterCircle.className = 'relative z-10 w-24 h-24 rounded-full bg-surface-container-high border-2 border-secondary/60 shadow-[0_0_28px_rgba(123,208,255,0.35)] flex flex-col items-center justify-center text-secondary transition-all duration-500';
    nfcCenterIcon.textContent = 'contactless';
    nfcCenterSub.textContent = 'ANTENNA';

    ripple1.className = 'absolute inset-6 rounded-full border border-secondary/60 animate-radar-1';
    ripple2.className = 'absolute inset-2 rounded-full border border-secondary/40 animate-radar-2';
    ripple3.className = 'absolute inset-0 rounded-full border border-secondary/30 animate-radar-3';

    nfcPayloadStatus.innerHTML = '<span class="material-symbols-outlined text-[12px] text-secondary">memory</span><span>488 Bytes Payload</span>';

    // State 2 (after 1.6s): Writing Cryptographic Ledger
    writeTimeout1 = setTimeout(() => {
      nfcBadgeText.textContent = 'WRITING CRYPTOGRAPHIC LEDGER';
      nfcBadgeDot.className = 'w-1.5 h-1.5 rounded-full bg-primary-container animate-ping';
      nfcModalTitle.textContent = 'Writing SafeScan Profile';
      nfcModalDesc.textContent = 'Encrypting & committing 488 bytes NDEF records to hardware memory...';
      
      nfcCenterCircle.className = 'relative z-10 w-24 h-24 rounded-full bg-surface-container-high border-2 border-primary-container shadow-[0_0_32px_rgba(255,84,81,0.45)] flex flex-col items-center justify-center text-primary-container transition-all duration-500 scale-105';
      nfcCenterIcon.textContent = 'sync_saved_locally';
      nfcCenterSub.textContent = 'ENCRYPTING';

      ripple1.className = 'absolute inset-6 rounded-full border border-primary-container/70 animate-radar-1';
      ripple2.className = 'absolute inset-2 rounded-full border border-primary-container/50 animate-radar-2';
      ripple3.className = 'absolute inset-0 rounded-full border border-primary-container/30 animate-radar-3';

      let currentProgress = 0;
      progressInterval = setInterval(() => {
        currentProgress += Math.floor(Math.random() * 18) + 12;
        if (currentProgress > 95) currentProgress = 95;
        nfcProgressBar.style.width = currentProgress + '%';
        nfcPercentText.textContent = currentProgress + '%';
      }, 140);
    }, 1600);

    // State 3 (after 3.3s): Sync Complete & Checksum Verified
    writeTimeout2 = setTimeout(() => {
      clearInterval(progressInterval);
      nfcProgressBar.style.width = '100%';
      nfcPercentText.textContent = '100%';

      nfcBadgeText.textContent = 'TAG WRITE COMPLETE • NTAG216';
      nfcBadgeDot.className = 'w-1.5 h-1.5 rounded-full bg-tertiary';
      nfcModalTitle.textContent = 'Tag Synchronized Successfully!';
      nfcModalDesc.textContent = 'Medical profile locked & signed. Verified Checksum 7F4A-98C1.';

      nfcCenterCircle.className = 'relative z-10 w-24 h-24 rounded-full bg-tertiary text-on-tertiary border-2 border-tertiary shadow-[0_0_36px_rgba(78,222,163,0.6)] flex flex-col items-center justify-center transition-all duration-500 scale-110';
      nfcCenterIcon.textContent = 'check_circle';
      nfcCenterSub.textContent = 'VERIFIED';

      ripple1.className = 'absolute inset-6 rounded-full border border-tertiary/70 animate-pulse';
      ripple2.className = 'absolute inset-2 rounded-full border border-tertiary/40 animate-pulse';
      ripple3.className = 'absolute inset-0 rounded-full border border-tertiary/20 animate-pulse';

      nfcPayloadStatus.innerHTML = '<span class="material-symbols-outlined text-[12px] text-tertiary">verified_user</span><span class="text-tertiary font-semibold">AES-256 Validated</span>';

      nfcCancelBtn.classList.add('hidden');
      nfcDoneBtn.classList.remove('hidden');
      nfcDoneBtn.classList.add('flex');
    }, 3400);
  }

  function closeNfcModal() {
    clearTimeout(writeTimeout1);
    clearTimeout(writeTimeout2);
    clearInterval(progressInterval);

    nfcSheet.classList.remove('translate-y-0');
    nfcSheet.classList.add('translate-y-8', 'sm:translate-y-4');
    nfcModal.classList.remove('opacity-100', 'pointer-events-auto');
    nfcModal.classList.add('opacity-0', 'pointer-events-none');
  }

  if (syncBtn) {
    syncBtn.addEventListener('click', openNfcModal);
  }

  if (nfcCloseBtn) nfcCloseBtn.addEventListener('click', closeNfcModal);
  if (nfcCancelBtn) nfcCancelBtn.addEventListener('click', closeNfcModal);
  if (nfcDoneBtn) nfcDoneBtn.addEventListener('click', closeNfcModal);

  // Close when clicking outside modal sheet
  if (nfcModal) {
    nfcModal.addEventListener('click', (e) => {
      if (e.target === nfcModal) {
        closeNfcModal();
      }
    });
  }

  // Interactive blood type chip selection
  const bloodButtons = document.querySelectorAll('#blood-selector button');
  bloodButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      bloodButtons.forEach(b => {
        b.className = 'py-2 rounded-lg bg-surface-container-high text-on-surface font-telemetry-data text-body-sm transition-all hover:bg-surface-bright';
        const pip = b.querySelector('span.rounded-full');
        if (pip) pip.remove();
      });
      btn.className = 'py-2 rounded-lg bg-primary-container text-on-primary-container font-telemetry-data text-body-sm shadow-md font-bold flex flex-col items-center justify-center relative';
      const indicator = document.createElement('span');
      indicator.className = 'w-1.5 h-1.5 rounded-full bg-primary-fixed mt-0.5';
      btn.appendChild(indicator);
    });
  });
</script></main><nav class="fixed bottom-0 w-full z-40 pb-safe bg-surface/85 backdrop-blur-xl shadow-[0_-2px_12px_rgba(0,0,0,0.3)]" data-active-classes="text-secondary bg-surface-container-high/60"><div class="flex justify-around items-center h-16 px-gutter"><a aria-current="page" class="flex flex-col items-center justify-center min-w-[56px] min-h-[44px] py-1 px-2 rounded-xl transition-colors text-secondary bg-surface-container-high/60" data-path="patient-hud" href="#"><span class="material-symbols-outlined text-[22px]">monitor_heart</span><span class="font-label-caps text-label-caps mt-0.5">HUD</span></a><a class="flex flex-col items-center justify-center min-w-[56px] min-h-[44px] py-1 px-2 rounded-xl text-on-surface-variant hover:text-on-surface transition-colors" data-path="nfc-scanner" href="#"><span class="material-symbols-outlined text-[22px]">sensors</span><span class="font-label-caps text-label-caps mt-0.5">SCAN</span></a><a class="flex flex-col items-center justify-center min-w-[56px] min-h-[44px] py-1 px-2 rounded-xl text-on-surface-variant hover:text-on-surface transition-colors" data-path="triage-feed" href="#"><span class="material-symbols-outlined text-[22px]">emergency</span><span class="font-label-caps text-label-caps mt-0.5">TRIAGE</span></a><a class="flex flex-col items-center justify-center min-w-[56px] min-h-[44px] py-1 px-2 rounded-xl text-on-surface-variant hover:text-on-surface transition-colors" data-path="incident-log" href="#"><span class="material-symbols-outlined text-[22px]">receipt_long</span><span class="font-label-caps text-label-caps mt-0.5">LOG</span></a></div></nav>



